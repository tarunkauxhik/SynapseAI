# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# Use SERVICE_ROLE key for backend operations to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://your-llm-gateway/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=MiniMax-M3

# Web search (optional but recommended; without it only Wikipedia is used)
TAVILY_API_KEY=your-tavily-api-key

# Evals: agent model allowlist (first = default; the judge is never used as an agent),
# judge model, and cases run in parallel
EVAL_AGENT_MODELS=MiniMax-M3,MiniMax-M2.5-highspeed
EVAL_JUDGE_MODEL=MiniMax-M2.7
EVAL_CONCURRENCY=3

# LOCAL DEV ONLY: keep this false on any backend that shares the production database,
# or its restarts mark production's live tasks/eval runs as failed.
# Don't set it on Render (production defaults to true: interrupted work is failed on startup).
STARTUP_SWEEP=false

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
